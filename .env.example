# Accel Business — Udyam Digital environment variables
# Copy to .env and fill in secrets before running locally.
# NOTE: Generate JWT_SECRET with: openssl rand -hex 32 (or any 32+ char random string)
# NOTE: Generate APP_ENCRYPTION_KEY with:
#       python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#       (any non-empty string also works — the key is SHA-256-derived)

# App
APP_NAME="Accel Business - Udyam Digital"
APP_ENV=dev
DATABASE_URL=postgresql+psycopg2://accel:accel@localhost:5432/accel
DEMO_TODAY=2026-07-15
DATA_DIR=./data
UPLOAD_DIR=./uploads
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Security (REQUIRED — no defaults)
JWT_SECRET=replace-with-a-strong-random-secret
APP_ENCRYPTION_KEY=replace-with-a-32-byte-base64-encryption-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma separated — include frontend origin, required for credentials)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting
RATE_LIMIT_SIGNIN_PER_MIN=5
RATE_LIMIT_SIGNUP_PER_MIN=3
RATE_LIMIT_OTP_PER_MIN=5
RATE_LIMIT_ADVISOR_PER_MIN=30
LOCKOUT_AFTER_FAILURES=5
LOCKOUT_MINUTES=15

# OTP
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_DEV_MODE=true
TWILIO_VERIFY_SERVICE_SID=

# Admin seed (dev only)
ADMIN_EMAIL=admin@accelbusiness.in
ADMIN_PASSWORD=AccelAdmin2026!
SALES_EMAIL=sales@accelbusiness.in
SALES_PASSWORD=AccelSales2026!
PARTNER_EMAIL=partner@accelbusiness.in
PARTNER_PASSWORD=AccelPartner2026!

# Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@accelbusiness.in
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
WHATSAPP_WEBHOOK_TOKEN=

# LLM
ANTHROPIC_API_KEY=
LLM_PROVIDER=offline
OPENAI_API_KEY=
OPENAI_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434
